# Active buzzer rhythm demo
PRINT BEEP DEMO START
WRITE /dev/buzzer 1
WAIT 120
WRITE /dev/buzzer 0
WAIT 120
WRITE /dev/buzzer 1
WAIT 120
WRITE /dev/buzzer 0
WAIT 300
WRITE /dev/buzzer 1
WAIT 360
WRITE /dev/buzzer 0
WAIT 120
WRITE /dev/buzzer 1
WAIT 360
WRITE /dev/buzzer 0
WAIT 120
WRITE /dev/buzzer 1
WAIT 360
WRITE /dev/buzzer 0
WAIT 300
WRITE /dev/buzzer 1
WAIT 120
WRITE /dev/buzzer 0
WAIT 120
WRITE /dev/buzzer 1
WAIT 120
WRITE /dev/buzzer 0
PRINT BEEP DEMO PASS
STOP
