# RGB sequence
PRINT RGB SHOW START
WRITE /dev/rgb/red 255
WRITE /dev/rgb/green 0
WRITE /dev/rgb/blue 0
WAIT 500
WRITE /dev/rgb/red 0
WRITE /dev/rgb/green 255
WAIT 500
WRITE /dev/rgb/green 0
WRITE /dev/rgb/blue 255
WAIT 500
WRITE /dev/rgb/red 255
WRITE /dev/rgb/green 255
WAIT 500
WRITE /dev/rgb/blue 0
WAIT 500
WRITE /dev/rgb/red 0
WRITE /dev/rgb/green 0
PRINT RGB SHOW PASS
STOP
